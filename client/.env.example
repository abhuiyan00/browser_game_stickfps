# Dev: the server runs on :9090 while the Vite page is on :5173. The client
# derives the WebSocket URL (ws(s)://<host>/ws) from these.
VITE_SERVER_URL=http://localhost
VITE_SERVER_PORT=9090
# Production: set VITE_SERVER_URL to your deployed server's https URL and leave
# VITE_SERVER_PORT blank (443 is implied) — e.g. VITE_SERVER_URL=https://your-app.onrender.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
